# Soda credentials — used by the Soda Claude plugin and the soda-mcp server.
#
# 1. Fill in your Soda Cloud API key. Create one in Soda Cloud under your
#    avatar -> Profile -> API Keys -> +
#    (https://docs.soda.io/reference/soda-apis/generate-api-keys)
# 2. Set SODA_CLOUD_HOST to your Soda Cloud region:
#      cloud.soda.io     (EU)
#      cloud.us.soda.io  (US)
# 3. Set SODA_PYPI_HOST to the private PyPI index for your license/region:
#      team.pypi.cloud.soda.io        (Team, EU)
#      team.pypi.us.soda.io           (Team, US)
#      enterprise.pypi.cloud.soda.io  (Enterprise, EU)
#      enterprise.pypi.us.soda.io     (Enterprise, US)
#
# Keep this file private (chmod 600). Do not commit it.

SODA_API_KEY_ID=<your-api-key-id>
SODA_API_KEY_SECRET=<your-api-key-secret>
SODA_CLOUD_HOST=cloud.soda.io
SODA_PYPI_HOST=team.pypi.cloud.soda.io
